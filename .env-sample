# Eatventure cloud-save login email - Not supported now - login manually
email=""

# Eatventure cloud-save login password - Not supported now - login manually
password=""

# Optional ADB serial. Leave empty to use the first connected device.
device_serial=""

# Optional: override the automatic template scale factor (computed from device resolution).
# Unity games sometimes render UI at a different size than raw resolution ratio suggests.
# Leave empty to use automatic scaling (recommended). Try "1.0" if auto-scale isn't working.
TEMPLATE_SCALE_OVERRIDE=""

# ── Optional features ───────────────────────────────────────

# Set to "1" to let the bot select the Popular Dish active skill.
# It only selects the first dish, starts the skill and immediately
# stops it again - the skill effect is not used at all. This is
# useful only to complete the Masterchef quest for selecting a
# popular dish (it counts selections). Repeats after every
# renovation / new city and every ~10 min (skill cooldown).
# Default "0" (off).
POPULAR_DISH_ENABLED="0"

# Set to "1" to let the bot accept Food Delivery orders. Whenever the
# delivery truck button (top-left) is available, it opens it and
# accepts the first order; the delivery then completes by itself.
# Useful mainly to complete the Food Delivery quest.
# Default "0" (off).
FOOD_DELIVERY_ENABLED="0"

# Whenever the helper (person) button (top-left) is available, the bot
# opens "Invite a helper" and invites the first helper. It works for
# ~4 min, then a ~30 min cooldown follows. The ad offered to extend it
# is never watched. Set to "0" to turn it off.
# Default "1" (on).
HELPER_INVITE_ENABLED="1"

# Right after the start and then every 5 hours the bot opens "Events"
# (party popper, top-right) and collects the free Adventures rewards
# (Zeus' Feast, Hangry Pirates) with "Complete last level" while the
# adventure still has keys. Runs offered for an ad are never used.
# Set to "0" to turn it off.
# Default "1" (on).
COLLECT_ADVENTURES_ENABLED="1"

# Potion Shop event (weekly, Saturday-Tuesday; cauldron button in the
# right column). Every 30 min the bot looks for it, enters it and plays
# it (stations, crates, upgrades, brewing potions) until the event
# ends. Work in progress. Boosts, ads and the Pass are never used.
# Default "0" (off).
POTION_SHOP_ENABLED="0"

# The bottles to brew after the rewards (Swift, Instant and Double are
# always brewed to 10 and kept) are ordered in potion_orders.txt: copy
# potion_orders-sample.txt to it and set the counts (edits apply without
# a restart; the bot lowers a count after each bottle).

# ── Logging ─────────────────────────────────────────────────

# Console log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default "INFO" matches previous print() output.
# Set to "DEBUG" for verbose output.
LOG_LEVEL="INFO"

# File log level: controls what gets written to logs/autoplay.log
# Default "DEBUG" captures everything for troubleshooting: what the bot
# found on the screen (score, position) and where it tapped or swiped.
LOG_FILE_LEVEL="DEBUG"

# MB that logs/autoplay.log and its old files take together, at most.
# A new file starts every 10 MB, the full ones are gzipped (~15x
# smaller, read them with zless / zgrep) and the oldest are deleted.
# Default "100" (a few weeks of logs).
LOG_MAX_MB="100"

# Days to keep the daily files of logs/key_events.log (key milestones
# only, a few KB a day). Default "365".
KEY_LOG_MAX_DAYS="365"
