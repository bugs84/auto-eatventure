# Eatventure cloud-save login email - Not supported now - login manually
email=""

# Eatventure cloud-save login password - Not supported now - login manually
password=""

# Optional ADB serial. Leave empty to use the first connected device.
device_serial=""

# Set to "1" # only when troubleshooting template detection.
#     It prints raw `cv2.matchTemplate` min/max values for each check,
#     which is useful for tuning but very noisy during normal runs.
# Keep "0" for normal gameplay automation.
DEBUG_TEMPLATE_MATCHING="0"
